# Shared Environment Variables (safe to commit)
# DO NOT put secrets or API keys here!

# Local Development Database (SQLite)
DATABASE_URL="file:./dev.db"

# NextAuth URL (override in .env.local for local dev)
NEXTAUTH_URL="http://localhost:3000"

# Note: All secrets and API keys should go in .env.local (git-ignored)
# Production values are set directly in Vercel dashboard