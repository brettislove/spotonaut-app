# Environment Variables Example
# Copy this file to .env and fill in your values

# Database (Local Development - SQLite)
DATABASE_URL="file:./dev.db"

# Database (Production - Vercel Postgres)
# These will be automatically set by Vercel when you add Vercel Postgres storage
# POSTGRES_URL=""
# POSTGRES_PRISMA_URL=""
# POSTGRES_URL_NON_POOLING=""
# DIRECT_URL=""

# Google AI API Key (required)
GOOGLE_GENERATIVE_AI_API_KEY="your-google-ai-api-key"

# Google Maps API Key (required for Places API)
# Get your key from: https://console.cloud.google.com/google/maps-apis
# Enable Places API (New) and use Pro tier billing for 5k requests/month included
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Admin Emails (JSON array) - for Maps quota monitoring endpoint
# Example: ["admin@example.com", "another-admin@example.com"]
ADMIN_EMAILS='["your-email@example.com"]'

# API Keys
# Add your API keys here

# Stripe (required for paid tiers)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_WEBHOOK_SECRET_THIN="whsec_xxx"

# Stripe Price IDs (replace with your own IDs)
STRIPE_PRICE_RAKETA_MONTH_CZK="price_xxx"
STRIPE_PRICE_SATELLITE_MONTH_CZK="price_xxx"

STRIPE_PRICE_RAKETA_MONTH_EUR="price_xxx"
STRIPE_PRICE_SATELLITE_MONTH_EUR="price_xxx"
