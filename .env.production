# Production Environment Variables - REFERENCE ONLY
# This file is NOT used directly. Set these in your Vercel dashboard:
# Project Settings → Environment Variables → Production

# ============================================
# REQUIRED for Production:
# ============================================

# Database - Auto-set by Vercel Postgres
DATABASE_URL="<auto-set-by-vercel-postgres>"

# NextAuth - Replace with your actual domain
NEXTAUTH_URL="https://spotonaut-app.vercel.app"
NEXTAUTH_SECRET="oNp/EQi8JVQP4CcAchPAyMAcInkGe5cz1RWp77HbxeE="

# AI Service
GOOGLE_GENERATIVE_AI_API_KEY="<your-google-ai-key>"

# ============================================
# OPTIONAL (for authentication features):
# ============================================

# Google OAuth - From Google Cloud Console
GOOGLE_CLIENT_ID="<your-google-client-id>"
GOOGLE_CLIENT_SECRET="<your-google-client-secret>"

# Email Service - From resend.com
RESEND_API_KEY="<your-resend-api-key>"

# ============================================
# How to set in Vercel:
# ============================================
# 1. Go to https://vercel.com/your-project
# 2. Settings → Environment Variables
# 3. Add each variable above for "Production" environment
# 4. Redeploy your app
